# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#     cp .env.example .env
# `.env` is git-ignored so your real settings won't be committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI configuration
# ---------------------------------------------------------------------------
# The GCP project and region used for the Gemini Live API (Vertex AI).
# Authenticate first with:  gcloud auth application-default login
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# Note: gemini-3.5-live-translate-preview and gemini-3.5-transcribe-live-preview only support "global" region.
GOOGLE_CLOUD_LOCATION="global"

# Gemini Live models
TRANSLATION_MODEL_ID="gemini-3.5-live-translate-preview"
TRANSCRIPTION_MODEL_ID="gemini-3.5-transcribe-live-preview"
LIVE_API_MODEL="gemini-3.5-transcribe-live-preview"
DEFAULT_MODE="transcription"

# ---------------------------------------------------------------------------
# Default translation direction (BCP-47 codes supported by Gemini 3.5 Live)
# ---------------------------------------------------------------------------
# Default input  language: Chinese (Simplified)
DEFAULT_SOURCE_LANG="Chinese (Simplified)"
DEFAULT_SOURCE_LANG_CODE="zh-Hans"
# Default output language: English
DEFAULT_TARGET_LANG="English"
DEFAULT_TARGET_LANG_CODE="en"

# ---------------------------------------------------------------------------
# Session settings
# ---------------------------------------------------------------------------
# On Stop, the Live API session is kept alive (paused) for instant resume.
# Close it after this many seconds of inactivity to avoid holding a billable
# session open. A new Start after this will reconnect.
IDLE_CLOSE_SECONDS="600"

# Verbose logging of raw Live API transcription timing (true/false).
DEBUG_LIVE_API="false"
